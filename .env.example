# ===========================================
# Portfolio Firwanto — Environment Configuration
# ===========================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# --- Supabase (Public) ---
# These are safe for client-side use with properly configured RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# --- Supabase (Server Only) ---
# This key bypasses RLS. NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Admin Authorization ---
# Comma-separated list of email addresses allowed to access the admin dashboard.
# Example: admin@example.com,backup@example.com
ADMIN_EMAIL_ALLOWLIST=your-admin-email@example.com

# --- Site Configuration ---
# The public URL of the deployed site. Used for auth redirects and SEO.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
