# ─────────────────────────────────────────────────────────────────────────────
# Supabase Public Configuration (Client & Server)
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
# Optional fallback alias:
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Canonical Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Server-Only Secret Configuration (Bypasses RLS — Never expose to client)
# ─────────────────────────────────────────────────────────────────────────────
SUPABASE_SECRET_KEY=your-supabase-secret-or-service-role-key
# Optional fallback alias:
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-or-service-role-key

# Authorized Admin Emails (Comma-separated list for single-admin policy)
ADMIN_EMAIL_ALLOWLIST=firwanto.debian@gmail.com

# ─────────────────────────────────────────────────────────────────────────────
# PostgreSQL Database Connections (For Supabase CLI / Migrations)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres
